# Directories
alias conf="cd ~/.config"

# Edit file
alias zshconf="nv ~/.config/zsh"

# reload zsh config
alias zshrl="source ~/.zshrc"

# Executables

alias nv="nvim"

alias vlc='/Applications/VLC.app/Contents/MacOS/VLC'

alias ff='ffmpeg -hide_banner'

# like npm ci
alias pnpmi='pnpm install --lockfile-only'
